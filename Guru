<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guru - Terminal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #020617; color: #f1f5f9; margin: 0; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 16px; box-sizing: border-box; }
        .glass { background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .glow { box-shadow: 0 0 25px rgba(16, 185, 129, 0.15); }
        .selected-item { border-color: #10b981 !important; background: rgba(16, 185, 129, 0.15) !important; color: #34d399 !important; }
        
        /* Offline Fallback Styles just in case CDN fails to load */
        .hidden { display: none !important; }
        .fixed { position: fixed; }
        .inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
        .flex { display: flex; }
        .flex-col { flex-direction: column; }
        .items-center { align-items: center; }
        .justify-center { justify-content: center; }
        .justify-between { justify-content: space-between; }
        .w-full { width: 100%; }
        .max-w-md { max-width: 28rem; }
        .max-w-xs { max-width: 20rem; }
        .max-w-sm { max-width: 24rem; }
        .p-4 { padding: 1rem; }
        .p-6 { padding: 1.5rem; }
        .rounded-3xl { border-radius: 1.5rem; }
        .rounded-2xl { border-radius: 1rem; }
        .rounded-xl { border-radius: 0.75rem; }
        .bg-slate-950 { background-color: #020617; }
        .bg-slate-900 { background-color: #0f172a; }
        .text-white { color: #ffffff; }
        .text-emerald-400 { color: #34d399; }
        .text-slate-400 { color: #94a3b8; }
        input, select { background-color: #0f172a; color: #f1f5f9; border: 1px solid #1e293b; border-radius: 0.75rem; padding: 0.65rem 1rem; font-size: 0.875rem; box-sizing: border-box; }
        button { cursor: pointer; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-center items-center p-4">

    <!-- Flash Loading Screen -->
    <div id="flashScreen" class="fixed inset-0 bg-slate-950 z-50 flex flex-col items-center justify-center transition-opacity duration-700">
        <div class="relative mb-4">
            <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-emerald-500 to-cyan-500 flex items-center justify-center glow animate-pulse" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; background: linear-gradient(to top right, #10b981, #06b6d4);">
                <span class="text-3xl font-black text-slate-950" style="font-size: 1.875rem; font-weight: 900; color: #020617;">G</span>
            </div>
        </div>
        <h1 class="text-2xl font-black tracking-wider text-white" style="font-size: 1.5rem; font-weight: 900; color: #ffffff; margin-top: 10px;">GURU <span class="text-emerald-400" style="color: #34d399;">TERMINAL</span></h1>
        <p class="text-xs text-slate-400 mt-1 uppercase tracking-widest" style="font-size: 0.75rem; color: #94a3b8; letter-spacing: 0.1em; text-transform: uppercase;">Loading Secure POS System...</p>
    </div>

    <!-- Worker PIN Login Modal -->
    <div id="loginModal" class="fixed inset-0 bg-slate-950/90 z-40 flex items-center justify-center p-4" style="background: rgba(2, 6, 23, 0.9);">
        <div class="glass w-full max-w-xs rounded-3xl p-6 shadow-2xl text-center" style="width: 100%; max-width: 20rem; padding: 1.5rem; text-align: center;">
            <h2 class="text-lg font-extrabold text-white mb-1" style="font-size: 1.125rem; font-weight: 800; color: #ffffff; margin-bottom: 0.25rem;">GURU POS SYSTEM </h2>
            <p class="text-xs text-slate-400 mb-4" style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 1rem;">Enter your 4-digit PIN (Try: 1234)</p>
            <input type="password" id="workerPinInput" maxlength="4" placeholder="••••" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-center text-xl tracking-widest text-white mb-4 focus:outline-none focus:border-emerald-500" style="width: 100%; text-align: center; font-size: 1.25rem; letter-spacing: 0.2em; margin-bottom: 1rem;">
            <button onclick="verifyWorkerPin()" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-3 rounded-xl text-sm transition-all shadow-lg" style="width: 100%; background-color: #10b981; color: #020617; font-weight: 700; padding: 0.75rem; border: none; border-radius: 0.75rem;">Login </button>
        </div>
    </div>

    <!-- Main Worker Interface -->
    <div class="w-full max-w-md glass rounded-3xl p-6 shadow-2xl relative overflow-hidden hidden" id="workerMainApp" style="width: 100%; max-width: 28rem; padding: 1.5rem; position: relative;">
        <div class="flex justify-between items-center mb-4" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
                <h1 class="text-xl font-extrabold text-white" style="font-size: 1.25rem; font-weight: 800; color: #ffffff;">GURU <span class="text-emerald-400" style="color: #34d399;">POS</span></h1>
                <p id="workerGreeting" class="text-xs text-emerald-400 font-medium" style="font-size: 0.75rem; color: #34d399;">Logged in successfully</p>
            </div>
            <button onclick="openClosingModal()" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs rounded-xl font-bold transition-all" style="background: rgba(245, 158, 11, 0.1); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); padding: 0.375rem 0.75rem; border-radius: 0.75rem; font-size: 0.75rem; font-weight: 700;">Day Closing</button>
        </div>

        <!-- Business Selector -->
        <div class="mb-3" style="margin-bottom: 0.75rem;">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Select Active Business</label>
            <select id="businessType" class="w-full bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500 text-slate-200" style="width: 100%;">
                <option value="clothing">Clothing Store</option>
            </select>
        </div>

        <!-- Tap to Select Item Grid (Multiple Select Support) -->
        <div class="mb-3" style="margin-bottom: 0.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-400" style="font-size: 0.70rem; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Tap Items to Sell (Multiple)</label>
                <span id="selectedItemsPreview" style="font-size: 0.7rem; color: #34d399; font-weight: 600;">None selected</span>
            </div>
            <div id="itemCatalogGrid" class="grid grid-cols-3 gap-2 max-h-32 overflow-y-auto p-1 bg-slate-900/40 border border-slate-800 rounded-2xl" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; max-height: 8rem; overflow-y: auto; padding: 0.25rem; background: rgba(15, 23, 42, 0.4); border: 1px solid #1e293b; border-radius: 1rem;">
                <!-- Dynamically loaded items -->
            </div>
            <input type="hidden" id="selectedItemName" required>
        </div>

        <!-- Entry Form -->
        <form id="entryForm" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem;">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Quantity & Unit</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="number" id="itemQty" step="0.01" required placeholder="1" style="width: 100%;">
                        <select id="unitType" style="background: #020617; color: #34d399; font-weight: 600; padding: 0 0.5rem; border-radius: 0.75rem;">
                            <option value="Pcs">Pcs</option>
                            <option value="Kg">Kg</option>
                            <option value="Gram">Gram</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Total Amount (₹)</label>
                    <input type="number" id="itemAmount" required placeholder="500" style="width: 100%;">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem;">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Payment Mode</label>
                    <select id="paymentMode" onchange="toggleUdhaarField()" style="width: 100%;">
                        <option value="Cash">Cash</option>
                        <option value="Online">Online / UPI</option>
                        <option value="Credit">Udhaar</option>
                    </select>
                </div>
                <div id="udhaarNameBox" class="hidden">
                    <label class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #fbbf24; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Customer Name</label>
                    <input type="text" id="customerName" placeholder="Customer Name" style="width: 100%; border-color: rgba(245, 158, 11, 0.3);">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #fbbf24; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Correction Note (If any mistake)</label>
                <input type="text" id="correctionNote" placeholder="e.g., Price corrected" style="width: 100%; border-color: rgba(245, 158, 11, 0.3);">
            </div>

            <button type="submit" style="width: 100%; background-color: #10b981; color: #020617; font-weight: 800; padding: 0.75rem; border: none; border-radius: 0.75rem; text-transform: uppercase; font-size: 0.875rem; letter-spacing: 0.05em;">
                Submit & Sync Sale
            </button>
        </form>
    </div>

    <!-- Day Closing Modal -->
    <div id="closingModal" class="fixed inset-0 bg-slate-950/90 z-40 hidden flex items-center justify-center p-4" style="background: rgba(2, 6, 23, 0.9);">
        <div class="glass w-full max-w-sm rounded-3xl p-6 shadow-2xl" style="width: 100%; max-width: 24rem; padding: 1.5rem;">
            <h2 class="text-lg font-extrabold text-white mb-1" style="font-size: 1.125rem; font-weight: 800; color: #ffffff; margin-bottom: 0.25rem;">Day-End Cash Closing</h2>
            <p class="text-xs text-slate-400 mb-4" style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 1rem;">Count physical cash in box & submit report.</p>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-400 mb-1" style="font-size: 0.70rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; display: block;">Physical Cash in Drawer (₹)</label>
                    <input type="number" id="physicalCash" placeholder="Enter total cash" style="width: 100%;">
                </div>
                <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                    <button onclick="closeClosingModal()" style="width: 50%; background-color: #1e293b; color: #f1f5f9; border: none; padding: 0.65rem; border-radius: 0.75rem; font-weight: 700; font-size: 0.75rem;">Cancel</button>
                    <button onclick="submitDayClosing()" style="width: 50%; background-color: #fbbf24; color: #020617; border: none; padding: 0.65rem; border-radius: 0.75rem; font-weight: 800; font-size: 0.75rem;">Submit Report</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Firebase Script -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getDatabase, ref, push, set, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

        const firebaseConfig = {
          apiKey: "AIzaSyDxjF3LUx9WWFQiBp0lKv7SB2fo_czJMGs",
          authDomain: "fir-b3fd3.firebaseapp.com",
          databaseURL: "https://fir-b3fd3-default-rtdb.firebaseio.com",
          projectId: "fir-b3fd3",
          storageBucket: "fir-b3fd3.firebasestorage.app",
          messagingSenderId: "842699650692",
          appId: "1:842699650692:web:a159f06fb4a4030f1934d1"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        let activeWorkerName = "Worker";
        let globalCatalog = {};
        let selectedItemsList = []; // Array to store multiple selected items

        setTimeout(() => {
            const flash = document.getElementById('flashScreen');
            flash.style.opacity = '0';
            setTimeout(() => flash.remove(), 700);
        }, 1200);

        window.verifyWorkerPin = () => {
            const pin = document.getElementById('workerPinInput').value.trim();
            if (pin === "1234") {
                activeWorkerName = "GURU";
            } else if (pin === "5678") {
                activeWorkerName = "RAJU";
            } else if (pin === "0000") {
                activeWorkerName = "RAAZ";
            } else {
                alert("Invalid PIN! Fill Correct Pin");
                return;
            }
            document.getElementById('workerGreeting').textContent = `Logged in as: ${activeWorkerName}`;
            document.getElementById('loginModal').classList.add('hidden');
            document.getElementById('workerMainApp').classList.remove('hidden');
        };

        const businessSelect = document.getElementById('businessType');
        const catalogGrid = document.getElementById('itemCatalogGrid');
        const selectedItemInput = document.getElementById('selectedItemName');
        const selectedPreview = document.getElementById('selectedItemsPreview');

        function getDefaultItems(biz) {
            if (biz === 'clothing') return ['Jeans', 'T-Shirt', 'Shirt', 'Trouser'];
            if (biz === 'jewelry') return ['Gold Ring', 'Silver Chain', 'Bangles'];
            return ['Rohu Fish', 'Katla Fish', 'Feed'];
        }

        function updateSelectedItemsUI() {
            selectedItemInput.value = selectedItemsList.join(', ');
            selectedPreview.textContent = selectedItemsList.length > 0 ? selectedItemsList.join(', ') : 'None selected';
        }

        function renderCatalog(bizKey) {
            catalogGrid.innerHTML = '';
            selectedItemsList = [];
            updateSelectedItemsUI();

            let items = (globalCatalog && globalCatalog[bizKey]) ? globalCatalog[bizKey] : getDefaultItems(bizKey);
            if (!items || items.length === 0) items = getDefaultItems(bizKey);

            items.forEach(item => {
                const btn = document.createElement('button');
                btn.type = "button";
                btn.className = "p-2 bg-slate-900 border border-slate-800 rounded-xl text-xs font-bold text-slate-300 hover:border-emerald-500 transition-all text-center truncate";
                btn.style.cssText = "padding: 0.5rem; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 0.75rem; font-size: 0.75rem; font-weight: 700; color: #cbd5e1; text-align: center; cursor: pointer;";
                btn.textContent = item;

                btn.onclick = () => {
                    const index = selectedItemsList.indexOf(item);
                    if (index > -1) {
                        // Already selected, so remove it (deselect)
                        selectedItemsList.splice(index, 1);
                        btn.classList.remove('selected-item');
                        btn.style.borderColor = "#1e293b";
                        btn.style.background = "#0f172a";
                        btn.style.color = "#cbd5e1";
                    } else {
                        // Not selected, add it
                        selectedItemsList.push(item);
                        btn.classList.add('selected-item');
                        btn.style.borderColor = "#10b981";
                        btn.style.background = "rgba(16, 185, 129, 0.15)";
                        btn.style.color = "#34d399";
                    }
                    updateSelectedItemsUI();
                };
                catalogGrid.appendChild(btn);
            });
        }

        onValue(ref(db, 'config'), (snapshot) => {
            const configData = snapshot.val() || {};
            const businesses = configData.businesses || { clothing: "Clothing Store", jewelry: "Jewelry Shop", fishfarm: "Fish Farming" };
            globalCatalog = configData.catalog || {};

            businessSelect.innerHTML = '';
            Object.entries(businesses).forEach(([key, name]) => {
                const opt = document.createElement('option');
                opt.value = key;
                opt.textContent = name;
                businessSelect.appendChild(opt);
            });
            renderCatalog(businessSelect.value);
        });

        businessSelect.addEventListener('change', () => renderCatalog(businessSelect.value));

        window.toggleUdhaarField = () => {
            const mode = document.getElementById('paymentMode').value;
            const box = document.getElementById('udhaarNameBox');
            if (mode === 'Credit') box.classList.remove('hidden');
            else box.classList.add('hidden');
        };

        document.getElementById('entryForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const business = businessSelect.value;
            const itemsString = selectedItemInput.value;
            if (!itemsString) return alert("Please select at least one item from catalog!");

            const qty = document.getElementById('itemQty').value;
            const unit = document.getElementById('unitType').value;
            const amount = document.getElementById('itemAmount').value;
            const mode = document.getElementById('paymentMode').value;
            const customer = document.getElementById('customerName').value || 'Walk-in';
            const note = document.getElementById('correctionNote').value || 'Normal Sale';

            try {
                const entriesRef = ref(db, 'businesses/' + business + '/entries');
                await push(entriesRef, {
                    name: itemsString, // Saves multiple items joined by comma (e.g., "Jeans, T-Shirt")
                    quantity: Number(qty),
                    unit,
                    amount: Number(amount),
                    paymentMode: mode,
                    customerName: mode === 'Credit' ? customer : '',
                    correctionNote: note,
                    worker: activeWorkerName,
                    timestamp: Date.now()
                });
                alert("Sale Recorded Successfully!");
                document.getElementById('entryForm').reset();
                renderCatalog(businessSelect.value); // Reset catalog selections
            } catch (err) {
                alert("Error: " + err.message);
            }
        });

        window.openClosingModal = () => document.getElementById('closingModal').classList.remove('hidden');
        window.closeClosingModal = () => document.getElementById('closingModal').classList.add('hidden');

        window.submitDayClosing = async () => {
            const cash = document.getElementById('physicalCash').value;
            if (!cash) return alert("Enter cash amount!");
            await push(ref(db, 'closings'), {
                worker: activeWorkerName,
                physicalCash: Number(cash),
                timestamp: Date.now()
            });
            alert("Day closing report submitted !");
            closeClosingModal();
        };
    </script>
</body>
</html>
